---
// Static SEO content for a tool page. Rendered without a client:* directive,
// so it ships as plain HTML with zero JS. Hidden while editing via the
// `data-show-tool` attribute that ToolWrapper sets on <html>.
import type { WithContext, HowTo as HowToType } from "schema-dts";
import type { toType } from "../src/content/content";
import HowTo from "./HowTo";
import { Features } from "./Features";
import Faq from "./Faq.astro";
import { faqs } from "../src/content/faq";

type Props = {
  howTo: WithContext<HowToType>;
  features: { title: string; description: string }[];
  seoTitle: string;
  to: string;
  lang?: string;
};

const { howTo, features, seoTitle, to, lang } = Astro.props;
const faq = lang ? faqs[lang] : undefined;
const faqItems = faq?.items[to];
---

<div class="container">
  <Features features={features} tool={to as toType} />
</div>
<div class="container">
  <HowTo howTo={howTo} alt={seoTitle} imgSrc={to.replace("/", "")} />
</div>
{faq && faqItems && <Faq title={faq.title} items={faqItems} />}
